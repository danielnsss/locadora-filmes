# Locadora de Filmes — exemplo de configuracao do Docker Compose.
# Copie este arquivo para .env e substitua a senha antes de executar o projeto.

# Usuario e banco de dados do PostgreSQL.
POSTGRES_USER=locadora
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
POSTGRES_DB=locadora

# Endereco em que a porta 8000 da API sera disponibilizada no PC servidor.
# 127.0.0.1: acesso apenas pelo proprio servidor (padrao mais seguro).
# 0.0.0.0: permite conexoes de outro PC na mesma rede, se o firewall permitir.
API_HOST_BIND=127.0.0.1
